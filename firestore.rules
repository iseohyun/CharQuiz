rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 관리자 권한 확인 헬퍼 함수
    // 로그인된 사용자의 UID가 '/databases/{database}/documents/admins/{uid}'에 존재하는지 검사합니다.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 2. 관리자 명부 컬렉션 규칙
    // 누구나 로그인하면 읽을 수는 있으나, 쓰기/수정은 오직 파이어베이스 콘솔에서 수동으로만 가능하도록 제한합니다.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 본인 문서 판별 헬퍼: 로그인 사용자는 UID 일치, 비로그인 게스트는 GUEST_ 접두 문서 ID
    function isOwner(docId) {
      return (request.auth != null && request.auth.uid == docId)
          || (request.auth == null && docId.matches('^GUEST_.*'));
    }

    // 3. 건의사항(suggestions) 규칙은 앱의 건의 기능을 없애며 지웠습니다. 규칙이 없으면 모든 읽기·쓰기가 막힙니다.

    // 4. 스피드런 및 학습모드 랭킹 규칙
    // 누구나 조회 및 신규 기록 등록(게스트 포함)이 가능하나, 기존 기록의 수정/삭제는 관리자만 가능합니다.
    match /speedrun_rankings/{rankingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /study_rankings/{rankingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 5. 사용자 환경설정 문서 규칙
    match /users/{uid} {
      // 목록 조회(list)는 허용하지 않고 본인 문서의 단건 조회/쓰기만 허용합니다.
      allow get, write: if isOwner(uid);

      // 사용자 진행 상태 서브컬렉션 (하위 경로 모두 허용)
      match /progress/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // 사용자 복습통계 서브컬렉션 (하위 경로 모두 허용)
      match /study_stats/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // 6. 방문 기록 컬렉션 규칙
    match /visits/{userId} {
      allow get, write: if isOwner(userId);
    }

    // 7. NameQuiz 캐릭터 힌트 (NameQuiz/components/hint-handler.js)
    // 로그인한 사용자가 캐릭터마다 힌트를 하나 올리고(문서 ID = charKey__uid), 남의 힌트에 따봉을 누른다.
    // 따봉은 name_hint_likes 문서 하나와 힌트의 likeCount ±1 을 한 번에 써야 통과한다.
    function hintPath(hintId) {
      return /databases/$(database)/documents/name_hints/$(hintId);
    }
    function hintLikePath(likeId) {
      return /databases/$(database)/documents/name_hint_likes/$(likeId);
    }
    function isValidHintText(text) {
      return text is string && text.size() > 0 && text.size() <= 80;
    }
    function isValidAuthorName(name) {
      return name is string && name.size() <= 30;
    }

    match /name_hints/{hintId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['charKey', 'domain', 'koName', 'uid', 'authorName', 'text', 'likeCount', 'rev', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.domain in ['sanrio', 'teenieping']
        && request.resource.data.koName is string
        && request.resource.data.charKey == request.resource.data.domain + '__' + request.resource.data.koName
        && hintId == request.resource.data.charKey + '__' + request.auth.uid
        && isValidHintText(request.resource.data.text)
        && isValidAuthorName(request.resource.data.authorName)
        && request.resource.data.likeCount == 0
        && request.resource.data.rev is string
        && request.resource.data.rev.size() > 0
        && request.resource.data.rev.size() <= 20;

      allow update: if request.auth != null && (
        // 작성자: 글, 이름, 고친 때만
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'authorName', 'updatedAt'])
          && isValidHintText(request.resource.data.text)
          && isValidAuthorName(request.resource.data.authorName))
        ||
        // 다른 사용자: 따봉 문서를 만들거나 지우면서 likeCount 를 1만 바꿈
        (resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(hintLikePath(hintId + '__' + resource.data.rev + '__' + request.auth.uid))
              && existsAfter(hintLikePath(hintId + '__' + resource.data.rev + '__' + request.auth.uid)))
            ||
            (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(hintLikePath(hintId + '__' + resource.data.rev + '__' + request.auth.uid))
              && !existsAfter(hintLikePath(hintId + '__' + resource.data.rev + '__' + request.auth.uid)))
          ))
      );

      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /name_hint_likes/{likeId} {
      // 본인 따봉만 조회 (where uid == 내 uid)
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['hintId', 'rev', 'uid', 'charKey', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && likeId == request.resource.data.hintId + '__' + request.resource.data.rev + '__' + request.auth.uid
        && getAfter(hintPath(request.resource.data.hintId)).data.rev == request.resource.data.rev
        && getAfter(hintPath(request.resource.data.hintId)).data.charKey == request.resource.data.charKey
        && getAfter(hintPath(request.resource.data.hintId)).data.uid != request.auth.uid
        && getAfter(hintPath(request.resource.data.hintId)).data.likeCount == get(hintPath(request.resource.data.hintId)).data.likeCount + 1;

      // 취소: likeCount 를 같이 1 줄이거나, 힌트가 지워졌거나 새로 올려져(rev 가 다름) 남은 따봉일 때
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && (
          !existsAfter(hintPath(resource.data.hintId))
          || getAfter(hintPath(resource.data.hintId)).data.rev != resource.data.rev
          || getAfter(hintPath(resource.data.hintId)).data.likeCount == get(hintPath(resource.data.hintId)).data.likeCount - 1
        );
    }
  }
}
